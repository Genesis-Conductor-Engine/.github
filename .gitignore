# This repository lives at the home-directory root. Deny new top-level paths by
# default so credentials, application state, and unrelated repositories cannot
# become accidental commit candidates. Explicitly allow only the documented
# Genesis workspace surface; already-tracked paths remain tracked.
/*

!/.gitignore
!/.gitmodules
!/AGENTS.md
!/CLAUDE.md
!/LLMS.txt
!/copilot-instructions.md
!/llms.txt
!/package.json
!/package-lock.json
!/vercel.json
!/azure.yaml

!/.claude/
 /.claude/*

!/negotiate-x402/
!/negotiate-x402/**
!/.claude/launch.json

!/.claude-plugin/
/.claude-plugin/*
!/.claude-plugin/marketplace.json

!/.github/
!/.github/**

!/docs/
!/docs/**

!/profile/
!/profile/**

!/scripts/
!/scripts/**

!/gc-workers/
/gc-workers/*
!/gc-workers/x402-paid-service/
!/gc-workers/x402-paid-service/**
!/gc-workers/gc-crew-mcp-bridge/
!/gc-workers/gc-crew-mcp-bridge/**
!/gc-workers/intent-surface/
!/gc-workers/intent-surface/**

# Generated and sensitive files stay ignored even inside allowed directories.
**/.DS_Store
**/.claude/
**/node_modules/
**/coverage/
**/.wrangler/
**/__pycache__/
**/*.py[cod]
**/*.bak
**/*.pre-*
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*token*.txt
**/*recovery*code*.txt
gha-creds-*.json

# Holds a live Alchemy API key in plaintext, and the !/gc-workers/x402-paid-service/**
# negation above would otherwise make it committable. The key is not recorded in
# the sops vault or any env file, so the file must stay on disk — it just must
# never ship. Redact the key and vault it before removing this rule.
/gc-workers/x402-paid-service/DEPLOYMENT_STATUS.md
